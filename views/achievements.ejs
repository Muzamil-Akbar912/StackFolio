<% layout("layouts/boilerplate") %>

<section class="achievements-section">
    <div class="container">

        <!-- Heading -->
        <div class="text-center mb-5">

            <p class="achievements-small-text">
                MY ACHIEVEMENTS
            </p>

            <h1 class="achievements-title">
                Certifications & Achievements
            </h1>

            <p class="achievements-description">
                Certifications, achievements, and milestones from my learning journey.
            </p>

        </div>

        <!-- Achievement Cards -->
        <div class="row justify-content-center">

            <div class="col-md-6 col-lg-4 mb-4">

                <div class="achievement-card">

                    <h3>
                        Certification / Achievement
                    </h3>

                    <p class="achievement-issuer">
                        Issued By / Organization
                    </p>

                    <p>
                        Add a short description about this certification
                        or achievement.
                    </p>

                    <span class="badge text-bg-dark">
                        2026
                    </span>

                </div>

            </div>

        </div>

    </div>
</section>