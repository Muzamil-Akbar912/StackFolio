<% layout("layouts/boilerplate") %>

<section class="about-section">
    <div class="container">

        <div class="row align-items-center">

            <!-- About Text -->
            <div class="col-lg-8 mx-auto">

                <p class="about-small-text">
                    ABOUT ME
                </p>

                <h1 class="about-title">
                    My Journey in Technology
                </h1>

                <p class="about-text">
                    I'm a developer who enjoys building practical projects,
                    learning new technologies, and understanding how things
                    work behind the scenes.
                </p>

                <p class="about-text">
                    My journey started with web development and gradually
                    expanded into backend development, databases, and
                    different areas of technology.
